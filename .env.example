# Enterprise Agentic Research & Knowledge Platform - Environment Configuration
# Copy this file to .env for local development

# Application Metadata
APP_NAME="Enterprise Agentic Research & Knowledge Platform"
APP_VERSION="0.1.0"
APP_ENV="development"
DEBUG=true
LOG_LEVEL="INFO"

# API Routing
API_V1_PREFIX="/api/v1"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# LLM Configuration
# Providers: "mock" (default, zero keys required) or "openai"
LLM_PROVIDER="mock"
LLM_MODEL="gpt-4o-mini"
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=2

# OpenAI Provider Settings (Required only if LLM_PROVIDER="openai" or EMBEDDING_PROVIDER="openai")
# OPENAI_API_KEY="sk-..."
# OPENAI_BASE_URL=""

# Embedding Configuration
# Providers: "mock" (default, zero keys required) or "openai"
EMBEDDING_PROVIDER="mock"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSIONS=1536

# Database & Vector Storage (PostgreSQL + pgvector)
# Repositories: "in_memory" (default for offline dev/test) or "postgres" or "auto"
VECTOR_REPOSITORY_TYPE="auto"
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/agentic_db"
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
# Document & Knowledge Base Settings
STORAGE_DIR=".data/documents"
KNOWLEDGE_BASE_DIR="KB"
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
